extends Node
## Autoload "Audio". Buses, volume settings, pitch variation, music and ambience per zone.
## Gameplay never plays sounds directly: EventBus signals and Juice call into here.
##   Audio.pad_press(big, held)   Audio.relic(rarity)   Audio.footstep()   Audio.ui(&"ui_click")
##   Audio.set_volume(&"Music", 0.5)   Audio.start_loading() / stop_loading()
## Sounds are generated by tools/audio/gen_audio.py (see assets/audio/LICENSE.md).

const BUS_MUSIC: StringName = &"Music"
const BUS_SFX: StringName = &"SFX"
const BUS_UI: StringName = &"UI"
const BUS_AMB: StringName = &"Ambience"
const BUSES: Array[StringName] = [BUS_MUSIC, BUS_SFX, BUS_UI, BUS_AMB]
const SETTINGS_PATH: String = "user://audio.cfg"
const DIR: String = "res://assets/audio/"

const POOL_SIZE: int = 14
const PITCH_JITTER: float = 0.03            # +-3% on every one-shot, so repeats never sound machine-gunned
const COMBO_WINDOW_MS: int = 650            # presses closer than this build the combo
const COMBO_STEPS: Array[int] = [0, 2, 4, 7, 9, 12, 14, 16, 19, 21, 24]   # semitones, C major pentatonic, 2 octaves
const FADE_S: float = 2.0
const DEFAULT_VOL: Dictionary = {&"Master": 0.8, &"Music": 0.2, &"SFX": 0.9, &"UI": 0.7, &"Ambience": 0.22}

var _pool: Array[AudioStreamPlayer] = []
var _next: int = 0
var _cache: Dictionary = {}
var _music: Array[AudioStreamPlayer] = []   # two players, crossfaded
var _music_active: int = 0
var _amb: AudioStreamPlayer
var _loading: AudioStreamPlayer
var _combo: int = 0
var _last_press_ms: int = -100000
var _last_tick_ms: int = 0
var _zone: StringName = &""
var _vol: Dictionary = DEFAULT_VOL.duplicate()
var _muted: bool = false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_make_buses()
	_load_settings()
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = BUS_SFX
		add_child(p)
		_pool.append(p)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = BUS_MUSIC
		m.volume_db = -80.0
		add_child(m)
		_music.append(m)
	_amb = AudioStreamPlayer.new()
	_amb.bus = BUS_AMB
	add_child(_amb)
	_loading = AudioStreamPlayer.new()
	_loading.bus = BUS_UI
	add_child(_loading)
	var bus: Node = get_node_or_null("/root/EventBus")
	if bus != null:
		bus.zone_entered.connect(set_zone)
		bus.gate_opened.connect(func(_id: StringName) -> void: play(&"gate_open", 1.0, 0.0, BUS_SFX, false))
		bus.rebirth_done.connect(func(_p: BigNum) -> void: play(&"rebirth", 1.0, 0.0, BUS_SFX, false))
		bus.button_denied.connect(func(_id: StringName) -> void: play(&"ui_back", 0.8, -4.0, BUS_UI))
		bus.offline_gained.connect(func(_s: float, _g: Dictionary) -> void: play(&"relic_uncommon", 1.0, -6.0))
	get_tree().node_added.connect(_on_node_added)


## Music and ambience start with the first zone. Main calls zone_entered on load, but this covers a
## cold start where the signal fired before the autoload was listening.
func start(zone_id: StringName) -> void:
	set_zone(zone_id)


# ---------------------------------------------------------------- buses and settings
func _make_buses() -> void:
	for b in BUSES:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var idx: int = AudioServer.get_bus_count() - 1
			AudioServer.set_bus_name(idx, b)
			AudioServer.set_bus_send(idx, &"Master")
	# Music sits under a gentle low-pass-free compressor-less chain: just keep it quiet and let the mix breathe.


func set_volume(bus: StringName, linear: float, save := true) -> void:
	_vol[bus] = clampf(linear, 0.0, 1.0)
	var idx: int = AudioServer.get_bus_index(bus)
	if idx != -1:
		AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(_vol[bus] as float, 0.0001)))
		AudioServer.set_bus_mute(idx, (_vol[bus] as float) <= 0.001 or (bus == &"Master" and _muted))
	if save:
		_save_settings()


func get_volume(bus: StringName) -> float:
	return _vol.get(bus, 1.0) as float


func set_muted(on: bool) -> void:
	_muted = on
	set_volume(&"Master", get_volume(&"Master"))


func is_muted() -> bool:
	return _muted


func _load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) == OK:
		for b: StringName in _vol.keys():
			_vol[b] = clampf(float(cfg.get_value("volume", String(b), _vol[b])), 0.0, 1.0)
		_muted = bool(cfg.get_value("audio", "muted", false))
	for b: StringName in _vol.keys():
		set_volume(b, _vol[b] as float, false)


func _save_settings() -> void:
	var cfg := ConfigFile.new()
	for b: StringName in _vol.keys():
		cfg.set_value("volume", String(b), _vol[b])
	cfg.set_value("audio", "muted", _muted)
	cfg.save(SETTINGS_PATH)


# ---------------------------------------------------------------- one-shots
func _stream(name: String, folder := "sfx") -> AudioStream:
	var key: String = folder + "/" + name
	if _cache.has(key):
		return _cache[key] as AudioStream
	var path: String = "%s%s/%s.ogg" % [DIR, folder, name]
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
	_cache[key] = s
	return s


## Fire and forget. pitch is a multiplier, jitter adds the small random variation.
func play(name: StringName, pitch := 1.0, vol_db := 0.0, bus: StringName = BUS_SFX, jitter := true) -> void:
	var s: AudioStream = _stream(String(name))
	if s == null:
		return
	var p: AudioStreamPlayer = _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = s
	p.bus = bus
	p.volume_db = vol_db
	p.pitch_scale = pitch * (1.0 + (randf_range(-PITCH_JITTER, PITCH_JITTER) if jitter else 0.0))
	p.play()


## Pad press. Rapid repeats climb the pentatonic ladder, so holding a pad plays a rising run.
## big (crit) uses its own sound and does not advance the ladder past where it is.
func pad_press(big: bool, held := false) -> void:
	var now: int = Time.get_ticks_msec()
	if now - _last_press_ms <= COMBO_WINDOW_MS:
		_combo = mini(_combo + 1, COMBO_STEPS.size() - 1)
	else:
		_combo = 0
	_last_press_ms = now
	var semis: int = COMBO_STEPS[_combo]
	var pitch: float = pow(2.0, float(semis) / 12.0)
	if big:
		play(&"pad_big", pow(2.0, float(COMBO_STEPS[mini(_combo, 4)]) / 12.0), 0.0)
	else:
		play(&"pad_press", pitch, -2.0 - float(_combo) * 0.15)
	if held and now - _last_tick_ms > 70:
		_last_tick_ms = now
		play(&"popup_tick", 1.0 + float(_combo) * 0.04, -9.0)


func popup_tick() -> void:
	play(&"popup_tick", 1.0, -8.0)


const RARITY_VOL: Dictionary = {&"common": -4.0, &"uncommon": -3.0, &"rare": -2.0}

func relic(rarity: StringName) -> void:
	var name: StringName = StringName("relic_" + String(rarity))
	if _stream(String(name)) == null:
		name = &"relic_common"
	play(name, 1.0, RARITY_VOL.get(rarity, 0.0) as float, BUS_SFX, false)


var _step_i: int = 0
## Call once per footfall. Four variants, never the same twice in a row.
func footstep() -> void:
	_step_i = (_step_i + 1 + randi() % 3) % 4
	play(StringName("step_%d" % _step_i), randf_range(0.9, 1.1), -6.0, BUS_SFX, false)


func ui(name: StringName) -> void:
	play(name, 1.0, 0.0, BUS_UI)


## Hover and click on every button, wired automatically as buttons enter the tree.
func _on_node_added(n: Node) -> void:
	if n is BaseButton and not n.has_meta(&"audio_wired"):
		n.set_meta(&"audio_wired", true)
		var b: BaseButton = n as BaseButton
		b.mouse_entered.connect(func() -> void:
			if not b.disabled:
				play(&"ui_hover", 1.0, 0.0, BUS_UI))
		b.pressed.connect(func() -> void: play(&"ui_click", 1.0, 0.0, BUS_UI))


# ---------------------------------------------------------------- loading screen
func start_loading() -> void:
	var s: AudioStream = _stream("loading_loop")
	if s == null:
		return
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	_loading.stream = s
	_loading.volume_db = -8.0
	_loading.play()


func stop_loading() -> void:
	if _loading.playing:
		var tw: Tween = create_tween()
		tw.tween_property(_loading, "volume_db", -60.0, 0.4)
		tw.tween_callback(_loading.stop)


# ---------------------------------------------------------------- music and ambience
func set_zone(zone_id: StringName) -> void:
	if zone_id == _zone:
		return
	_zone = zone_id
	var quarry: bool = String(zone_id).begins_with("quarry") or zone_id == &"zone2"
	_crossfade_music("quarry" if quarry else "meadow")
	var a: AudioStream = _stream("quarry_amb" if quarry else "meadow_amb", "amb")
	if a != null:
		if a is AudioStreamOggVorbis:
			(a as AudioStreamOggVorbis).loop = true
		_amb.stream = a
		_amb.volume_db = -3.0
		_amb.play()


func _crossfade_music(name: String) -> void:
	var s: AudioStream = _stream(name, "music")
	if s == null:
		return
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	var old: AudioStreamPlayer = _music[_music_active]
	_music_active = 1 - _music_active
	var nw: AudioStreamPlayer = _music[_music_active]
	nw.stream = s
	nw.volume_db = -60.0
	nw.play()
	var tw: Tween = create_tween().set_parallel(true)
	tw.tween_property(nw, "volume_db", 0.0, FADE_S)
	if old.playing:
		tw.tween_property(old, "volume_db", -60.0, FADE_S)
		tw.chain().tween_callback(old.stop)
