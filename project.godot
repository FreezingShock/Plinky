; Engine configuration file. Edited by the integrator only (see README.md).
config_version=5

[application]

config/name="Plinky"
config/icon="res://assets/brand/plinky-icon-256.png"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://main.tscn"

[autoload]

EventBus="*res://core/event_bus.gd"
GameState="*res://core/game_state.gd"
Save="*res://core/save.gd"
Fx="*res://render/fx_driver.gd"
Juice="*res://ui/fx/fx_bus.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0

renderer/rendering_method="forward_plus"
