[gd_resource type="Resource" script_class="AreaDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/area_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"heronmere"
zone = &"larkmoor"
display_name = "Heronmere"
order = 1
icon = "lake"
theme_role = 7
blurb = "A reed-fringed lake with a little jetty. Three Sprout pads across the grass below the main path, paid in Dewdrops, and three Clover pads on the south shore, paid in Clover Leaves. Clover opens once the last Sprout pad is pressed."
pad_buttons = PackedStringArray("lark_sprout_1", "lark_sprout_2", "lark_sprout_3", "lark_clover_1", "lark_clover_2", "lark_clover_3")
