blurb = "The west bank of the lake, reached by the trail north of the water. Three more Starbloom pads, paid in Starbloom Petals and costing Foxglove Bells. The Starbloom row runs on here, and each pad costs far more than the last."
pad_buttons = PackedStringArray("starbloom_4", "starbloom_5", "starbloom_6")
